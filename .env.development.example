# .env.example — Template for the DEV / BETA server environment
# Used by: docker-compose.base.yml + docker-compose.dev.yml
# Copy to .env.development and fill in real values.
#
# For local development see .env.local.example instead.

# ─── Database ──────────────────────────────────────────────────────────────────
# Docker Compose service hostname is "db" — do not change to localhost
DATABASE_URL=postgresql://keshav:your-password@db:5432/keshav_kitchen_dev

# ─── PostgreSQL container ──────────────────────────────────────────────────────
POSTGRES_USER=keshav
POSTGRES_PASSWORD=your-password

# ─── Next.js app ───────────────────────────────────────────────────────────────
# Docker beta runs `next start` (not `next dev`), so NODE_ENV must be production
NODE_ENV=production
PORT=3000

# Must match the nginx location block prefix — no trailing slash
# Beta uses /beta-kitchen, prod uses /kitchen
NEXT_PUBLIC_BASE_PATH=/beta-kitchen
NEXT_PUBLIC_API_BASE_URL=/beta-kitchen/api

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Must match the public URL + basePath served by nginx (no port — nginx handles 80/443)
NEXTAUTH_URL=http://localhost/beta-kitchen

# ─── Database backups ──────────────────────────────────────────────────────────
BACKUP_SCHEDULE=@hourly
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ─── Puppeteer (Linux / Docker) ────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox
