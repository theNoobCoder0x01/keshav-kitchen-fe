# .env.local.example
# Copy this file to .env.local and fill in the values.
# .env.local overrides .env.development — so only set what differs from the defaults.
#
# SETUP:
#   cp .env.local.example .env.local
#   # Then edit .env.local with your values


# =============================================================================
# DATABASE CONNECTION — pick ONE option, comment out the others
# =============================================================================

# --- Option A: Local Docker DB (default) ------------------------------------
# Start the DB with: npm run dev:db
# Then run the app with: npm run dev
DATABASE_URL=postgresql://keshav:keshav123@localhost:5432/keshav_kitchen_dev

# --- Option B: Direct remote dev server connection --------------------------
# Fill in the actual IP/hostname of the remote dev server
# DATABASE_URL=postgresql://keshav:keshav123@<REMOTE_HOST>:5432/keshav_kitchen_dev

# --- Option C: SSH tunnel (localhost:5433) ----------------------------------
# Open the tunnel first: npm run dev:tunnel
# Then run: npm run dev
# DATABASE_URL=postgresql://keshav:keshav123@localhost:5433/keshav_kitchen_dev


# =============================================================================
# NEXT.JS BASE PATH
# =============================================================================

# Leave empty for local dev — the production value "/beta-kitchen" breaks routing locally
NEXT_PUBLIC_BASE_PATH=

# Local API path
NEXT_PUBLIC_API_BASE_URL=/api


# =============================================================================
# NEXTAUTH
# =============================================================================

NEXTAUTH_URL=http://localhost:3000

# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=<generate-a-random-secret-with-openssl-rand-base64-32>


# =============================================================================
# GENERAL
# =============================================================================

NODE_ENV=development
PORT=3000


# =============================================================================
# POSTGRES DOCKER CREDENTIALS
# Used by docker-compose.db-only.yml when starting the local DB container
# =============================================================================

POSTGRES_USER=keshav
POSTGRES_PASSWORD=keshav123


# =============================================================================
# SSH TUNNEL VARIABLES (Option C only)
# Used by: npm run dev:tunnel  →  scripts/tunnel-dev-db.sh
# =============================================================================

# Hostname or IP of the remote server you SSH into
SSH_DEV_HOST=
# SSH username on the remote server
SSH_DEV_USER=root
# (optional) path to your SSH private key — leave blank to use ssh-agent
# SSH_DEV_KEY=~/.ssh/id_rsa

# Remote DB details (as seen from inside the remote server)
REMOTE_DB_HOST=localhost
REMOTE_DB_PORT=5432

# Local port the tunnel binds to — must match DATABASE_URL above for Option C
LOCAL_DB_PORT=5433


# =============================================================================
# PUPPETEER
# =============================================================================

# On Linux (Docker / CI) Chromium is at /usr/bin/chromium — uncomment that line.
# On macOS, Puppeteer uses its own bundled Chromium by default — leave this commented out.
# If you need to point at your system Chrome on macOS:
#   PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
