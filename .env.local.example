# .env.local.example — Template for LOCAL DEVELOPMENT
# .env.local is loaded by Next.js with highest priority, overriding .env.development.
#
# FIRST-TIME SETUP:
#   cp .env.local.example .env.local
#   # Fill in NEXTAUTH_SECRET (required) and pick a DB option below
#   npm run dev:db   # start local Postgres (Option A)
#   npm run dev      # start the app at http://localhost:3000


# =============================================================================
# DATABASE — pick ONE option, comment out the others
# =============================================================================

# Option A: Local Docker DB ── npm run dev:db  (default)
DATABASE_URL=postgresql://keshav:keshav123@localhost:5432/keshav_kitchen_dev

# Option B: Direct connection to remote dev server
# DATABASE_URL=postgresql://keshav:keshav123@<SERVER_IP>:5432/keshav_kitchen_dev

# Option C: SSH tunnel ── npm run dev:tunnel  (binds remote DB to localhost:5433)
# DATABASE_URL=postgresql://keshav:keshav123@localhost:5433/keshav_kitchen_dev


# =============================================================================
# NEXT.JS
# =============================================================================

# Empty for local dev — the server value "/beta-kitchen" breaks routing locally
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_BASE_URL=/api


# =============================================================================
# AUTH
# =============================================================================

NEXTAUTH_URL=http://localhost:3000

# Required — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=


# =============================================================================
# GENERAL
# =============================================================================

NODE_ENV=development
PORT=3000


# =============================================================================
# POSTGRES — used by docker-compose.db-only.yml (Option A)
# =============================================================================

POSTGRES_USER=keshav
POSTGRES_PASSWORD=keshav123


# =============================================================================
# SSH TUNNEL — used by npm run dev:tunnel (Option C only)
# =============================================================================

SSH_DEV_HOST=
SSH_DEV_USER=root
# SSH_DEV_KEY=~/.ssh/id_rsa   # leave blank to use ssh-agent / default key

REMOTE_DB_HOST=localhost
REMOTE_DB_PORT=5432
LOCAL_DB_PORT=5433


# =============================================================================
# PUPPETEER
# =============================================================================

# macOS: leave commented — Puppeteer uses its own bundled Chromium automatically.
# Linux / Docker: uncomment the two lines below.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox
