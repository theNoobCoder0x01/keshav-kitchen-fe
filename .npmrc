# legacy-peer-deps: retained because several packages in the dependency tree
# declare peer dep ranges that do not formally include React 19 even though
# they work fine at runtime with it.  Specifically:
#
#   - formik@2.4.9            declares peerDep "react": ">=16.8.0"
#                             (broad range — actually compatible)
#   - react-day-picker@9.14.0 declares peerDep "react": ">=16.8.0"
#                             (broad range — actually compatible)
#   - react-is@16.13.1        (transitive dep of recharts) does not list react 19
#
# All of these work correctly with react@19.2.5 at runtime.  The flag will no
# longer be necessary once these packages publish updated peer-dep ranges.
# Do NOT remove this flag until confirmed by running `npm install` without it.
legacy-peer-deps=true
